# MySQL connection used by Prisma. Hostinger normally provides this value.
# connection_limit=5 keeps the application within shared-hosting connection limits.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/ashna_db?connection_limit=5"

# Public canonical URL, without a trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin access. Choose a unique random salt, then generate the scrypt hash with:
# node -e "console.log(require('node:crypto').scryptSync('YOUR_PASSWORD','YOUR_SALT',64).toString('hex'))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_SALT=
ADMIN_PASSWORD_SCRYPT=
# Generate a long random secret with: openssl rand -base64 48
AUTH_SECRET=
# Set true only after confirming that the hosting proxy overwrites forwarded-IP
# headers. Leave false when that guarantee is unavailable.
TRUST_PROXY_HEADERS=false

# SMTP account used to deliver administrator password-reset links.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Zia Ashna CMS <zia@ashna.af>"

# Server-side Formspree (or compatible JSON endpoint)
CONTACT_FORM_ENDPOINT=

# Required in production: AWS S3, Cloudflare R2, or compatible object storage.
# S3_PUBLIC_URL is the public bucket/CDN base URL, without /uploads or a trailing
# slash. Local filesystem uploads are allowed only outside production.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false
