# Local PostgreSQL connection used by Prisma.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/ashna_db?schema=public"

# Public canonical URL, without a trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin access. Choose a unique random salt, then generate the scrypt hash with:
# node -e "console.log(require('node:crypto').scryptSync('YOUR_PASSWORD','YOUR_SALT',64).toString('hex'))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_SALT=
ADMIN_PASSWORD_SCRYPT=
# Generate a long random secret with: openssl rand -base64 48
AUTH_SECRET=

# SMTP account used to deliver administrator password-reset links.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Zia Ashna CMS <no-reply@example.com>"

# Server-side Formspree (or compatible JSON endpoint)
CONTACT_FORM_ENDPOINT=

# Production media storage (AWS S3, Cloudflare R2, or another S3-compatible service).
# Local filesystem uploads are allowed only outside production.
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=false
