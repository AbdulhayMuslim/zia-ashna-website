# Public canonical URL, without a trailing slash
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin access. Choose a unique random salt, then generate the scrypt hash with:
# node -e "console.log(require('node:crypto').scryptSync('YOUR_PASSWORD','YOUR_SALT',64).toString('hex'))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_SALT=1234
ADMIN_PASSWORD_SCRYPT=
# Generate a long random secret with: openssl rand -base64 48
AUTH_SECRET=

# Server-side Formspree (or compatible JSON endpoint)
CONTACT_FORM_ENDPOINT=
