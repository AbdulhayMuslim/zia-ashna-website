{
  "name": "zia-ashna",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "packageManager": "npm@11.6.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11"
  },
  "scripts": {
    "predev": "npm run db:local:start && npm run db:deploy && prisma generate",
    "dev": "cross-env NODE_OPTIONS='--max_old_space_size=4096' next dev --webpack",
    "prebuild": "prisma generate",
    "build": "next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "db:deploy": "prisma migrate deploy",
    "db:local:start": "node scripts/local-mysql.mjs start",
    "db:local:stop": "node scripts/local-mysql.mjs stop",
    "db:local:status": "node scripts/local-mysql.mjs status",
    "env:check": "node scripts/check-production-env.mjs",
    "hostinger:build": "npm run env:check && npm run db:deploy && npm run build",
    "media:migrate:s3": "node scripts/migrate-local-media-to-s3.mjs",
    "lint": "eslint",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run lint && npm run test && next build --webpack"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@hookform/resolvers": "^5.4.0",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.9.1",
    "@radix-ui/react-dialog": "^1.1.19",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-text-align": "^3.31.3",
    "@tiptap/extension-underline": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "deepmerge-ts": "^8.0.2",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.21.0",
    "mariadb": "^3.5.4",
    "next": "^16.3.3",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.1.1",
    "prisma": "^7.9.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.82.0",
    "react-icons": "^5.7.0",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "^16.3.3",
    "tailwindcss": "^4"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "mysql2": "^3.23.1",
    "sharp": "$sharp"
  }
}
